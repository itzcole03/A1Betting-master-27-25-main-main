    "@tanstack/react-query": "^5.80.7",
    "eventemitter3": "^5.0.1",
    "framer-motion": "^12.19.2",
    "lucide-react": "^0.525.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.2",
    "recharts": "^2.8.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
